PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/devsentry
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
AI_MODEL_GEMINI=gemini-3.5-flash-lite
AI_MODEL_GROQ=openai/gpt-oss-20b
AI_TIMEOUT_MS=20000
AI_CONCURRENCY=1
AI_MAX_CALLS=10
AI_MAX_FINDINGS=10
AI_REVIEW_FILES=false
AI_REVIEW_TOP_FILES=3
MAX_REPO_SIZE_MB=100
CLONE_DEPTH=500
SCAN_TIMEOUT_MS=180000
SEMGREP_MODE=docker
SEMGREP_BIN=semgrep
LIZARD_BIN=lizard
SEMGREP_CONFIGS=semgrep-rules/devsentry.yml,p/javascript,p/typescript,p/python,p/java,p/security-audit
MAX_FILES=1000
MAX_FILE_KB=512
SCAN_CONCURRENCY=1
GITHUB_API_TOKEN=
